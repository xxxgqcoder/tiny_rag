# Put docker environmental variable here
# Variable should be in key-value format, for example: key=value, one variable per line. Do not remove existing variables.

# Image version to use
IMAGE=tiny_rag:dev

# ============================================================================ #
# RAG data
# Drectory for saving knowledge files on host machine
HOST_RAG_FILE_DIR=~/tiny_rag/files

# Directory for saving docker logs on host machine
HOST_RAG_LOG_DIR=~/tiny_rag/logs

# ============================================================================ #
# Chat model
# Chat model url, default to ollama. 
# NOTE: for tiny_rag to access host deployed ollama, you must set the domain to `http://host.docker.internal`
CHAT_MODEL_URL=http://host.docker.internal:11434

# The chat model name
CHAT_MODEL_NAME='qwen3:30b-a3b'
